
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Custom Pink Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body>

    <!-- NAVIGATION BAR -->
    <header>
        <nav class="navbar navbar-expand-lg raceday-navbar">
            <div class="container">

                <a class="navbar-brand raceday-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">♡</span> RaceDay

                    <small class="brand-tagline">
                        MAKE EVERY MILE COUNT
                    </small>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Auth"
                               asp-action="Register">
                                Register
                            </a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="nav-link nav-login"
                               asp-controller="Auth"
                               asp-action="Login">
                                Login
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container py-4 main-content">

        @RenderBody()

    </main>

    <!-- FOOTER -->
    <footer class="raceday-footer">

        <div class="container text-center">

            <div class="footer-brand">
                ♡ RaceDay
            </div>

            <p>
                Every race has a story. Make yours count.
            </p>

            <small>
                &copy; @DateTime.Now.Year RaceDay. All rights reserved.
            </small>

        </div>

    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
