@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = ViewBag.UserRole == "Participant"
        ? "Browse Events"
        : "My Events";

    bool isOrganiser = ViewBag.UserRole == "Organiser";
    bool isParticipant = ViewBag.UserRole == "Participant";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            @if (isOrganiser)
            {
                <h1>My Events</h1>
                <p class="text-muted">
                    View and manage your sporting events.
                </p>
            }
            else
            {
                <h1>Browse Events</h1>
                <p class="text-muted">
                    Discover sporting events and find one you would like to join.
                </p>
            }
        </div>

        @if (isOrganiser)
        {
            <a asp-controller="Event"
               asp-action="Create"
               class="btn btn-primary">
                + Create New Event
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm p-4 text-center">
            <h4>No events found</h4>

            @if (isOrganiser)
            {
                <p class="text-muted">
                    You haven't created any events yet.
                </p>

                <div>
                    <a asp-controller="Event"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Your First Event
                    </a>
                </div>
            }
            else
            {
                <p class="text-muted">
                    There are currently no sporting events available.
                    Please check again later.
                </p>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Event Banner</th>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Event Type</th>
                        <th>Registration Deadline</th>

                        @if (isOrganiser || isParticipant)
                        {
                            <th>Actions</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.BannerImage))
                                {
                                    <img src="@($"https://localhost:7230{item.BannerImage}")"
                                         alt="@item.Event_Name banner"
                                         style="width: 110px; height: 70px; object-fit: cover; border-radius: 6px;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No banner uploaded
                                    </span>
                                }
                            </td>

                            <td>@item.Event_Name</td>

                            <td>
                                @item.Event_Date.ToString("dd MMM yyyy")
                            </td>

                            <td>@item.Event_Location</td>

                            <td>@item.Event_Type</td>

                            <td>
                                @item.Registration_Deadline.ToString("dd MMM yyyy")
                            </td>

                            @if (isOrganiser)
                            {
                                <td>
                                    <div class="d-flex flex-wrap gap-2">

                                        <a asp-controller="Enrolment"
                                           asp-action="Index"
                                           asp-route-eventId="@item.EventId"
                                           class="btn btn-sm btn-primary">
                                            View Enrolments
                                        </a>

                                        <a asp-controller="Category"
                                           asp-action="Index"
                                           asp-route-id="@item.EventId"
                                           class="btn btn-sm btn-info">
                                            Manage Categories
                                        </a>

                                        <a asp-controller="Event"
                                           asp-action="Edit"
                                           asp-route-id="@item.EventId"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-controller="Results"
                                           asp-action="Index"
                                           asp-route-eventId="@item.EventId"
                                           class="btn btn-sm btn-primary">
                                            Manage Results
                                        </a>

                                        <form asp-controller="Event"
                                              asp-action="Delete"
                                              asp-route-id="@item.EventId"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Delete
                                            </button>

                                        </form>

                                    </div>
                                </td>
                            }
                            else if (isParticipant)
                            {
                                <td>
                                    <a asp-controller="Participant"
                                       asp-action="Categories"
                                       asp-route-eventId="@item.EventId"
                                       class="btn btn-sm btn-primary">
                                        View Categories & Enrol
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    @if (isOrganiser)
    {
        <a asp-controller="Organiser"
           asp-action="Dashboard"
           class="btn btn-secondary mt-3">
            Back to Dashboard
        </a>
    }
    else if (isParticipant)
    {
        <a asp-controller="Participant"
           asp-action="Dashboard"
           class="btn btn-secondary mt-3">
            Back to Dashboard
        </a>
    }

</div>
