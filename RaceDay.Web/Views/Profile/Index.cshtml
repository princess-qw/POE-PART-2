@model RaceDay.Web.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    bool isOrganiser = Model.Role == "Organiser";
    bool isParticipant = Model.Role == "Participant";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm p-4">

                <h2 class="mb-2">
                    @(isOrganiser ? "My Organiser Profile" : "My Participant Profile")
                </h2>

                <p class="text-muted">
                    View and update your personal information.
                </p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <!-- PROFILE PICTURE -->
                <div class="text-center mb-4">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                    {
                        <img src="@($"https://localhost:7230{Model.ProfilePictureUrl}")"
                             alt="Profile Picture"
                             class="rounded-circle shadow"
                             style="width:150px; height:150px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle shadow d-flex align-items-center justify-content-center mx-auto"
                             style="width:150px; height:150px; background:#fce4ec; color:#ad5277; font-size:55px;">
                            <i class="bi bi-person-circle"></i>
                        </div>
                    }

                    <h5 class="mt-3">Profile Picture</h5>

                    <p class="text-muted small">
                        Upload a JPG, PNG or WEBP image (maximum 5 MB).
                    </p>

                    <form asp-controller="Profile"
                          asp-action="UploadPicture"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <input type="file"
                                   name="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-upload"></i>
                            Upload Picture
                        </button>

                    </form>

                </div>

                <hr />

                <!-- PROFILE DETAILS -->
                <form asp-controller="Profile"
                      asp-action="Index"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />

                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    @if (isOrganiser)
                    {
                        <div class="mb-3">
                            <label asp-for="OrganisationName"
                                   class="form-label">
                                Organisation Name
                            </label>

                            <input asp-for="OrganisationName"
                                   class="form-control" />

                            <span asp-validation-for="OrganisationName"
                                  class="text-danger"></span>
                        </div>
                    }

                    @if (isParticipant)
                    {
                        <div class="mb-3">
                            <label asp-for="DateOfBirth"
                                   class="form-label">
                                Date of Birth
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger"></span>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                        @if (isOrganiser)
                        {
                            <a asp-controller="Organiser"
                               asp-action="Dashboard"
                               class="btn btn-secondary">
                                Back to Dashboard
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Participant"
                               asp-action="Dashboard"
                               class="btn btn-secondary">
                                Back to Dashboard
                            </a>
                        }

                    </div>

                </form>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
