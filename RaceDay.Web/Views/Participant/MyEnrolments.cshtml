@model List<RaceDay.Web.Models.MyEnrolmentViewModel>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h1>My Enrolments</h1>
    <p class="text-muted">
        View the sporting events and categories you have enrolled in.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm p-4 text-center">
            <h4>No enrolments found</h4>
            <p>You have not enrolled in any event yet.</p>
            <a asp-controller="Event"
               asp-action="Index"
               class="btn btn-primary">
                Browse Events
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Bib Number</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>
                                @(enrolment.Category?.CategoryName ?? "N/A")
                            </td>
                            <td>
                                @(enrolment.Category?.DistanceKm.ToString("N2") ?? "N/A") KM
                            </td>
                            <td>@enrolment.BibNumber</td>
                            <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Participant"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
