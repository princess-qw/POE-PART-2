@model RaceDay.Web.Models.CategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<div class="container mt-4">

    <h2>Add Event Category</h2>

    <p class="text-muted">
        Enter the details for the new event category.
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <input type="hidden" asp-for="EventId" />

                <div class="mb-3">
                    <label asp-for="CategoryName"
                           class="form-label"></label>
                    <input asp-for="CategoryName"
                           class="form-control"
                           placeholder="e.g. 10 KM Fun Run" />
                    <span asp-validation-for="CategoryName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DistanceKm"
                           class="form-label"></label>
                    <input asp-for="DistanceKm"
                           type="number"
                           step="0.01"
                           min="0.01"
                           class="form-control" />
                    <span asp-validation-for="DistanceKm"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EntryFee"
                           class="form-label"></label>
                    <input asp-for="EntryFee"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />
                    <span asp-validation-for="EntryFee"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaximumParticipation"
                           class="form-label"></label>
                    <input asp-for="MaximumParticipation"
                           type="number"
                           min="1"
                           class="form-control" />
                    <span asp-validation-for="MaximumParticipation"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartPoint"
                           class="form-label"></label>
                    <input asp-for="StartPoint"
                           class="form-control"
                           placeholder="Enter starting point" />
                    <span asp-validation-for="StartPoint"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndPoint"
                           class="form-label"></label>
                    <input asp-for="EndPoint"
                           class="form-control"
                           placeholder="Enter finishing point" />
                    <span asp-validation-for="EndPoint"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ElevationGainM"
                           class="form-label"></label>
                    <input asp-for="ElevationGainM"
                           type="number"
                           min="0"
                           class="form-control" />
                    <span asp-validation-for="ElevationGainM"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MapUrl"
                           class="form-label"></label>
                    <input asp-for="MapUrl"
                           type="url"
                           class="form-control"
                           placeholder="https://example.com/map" />
                    <span asp-validation-for="MapUrl"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Category
                </button>

                <a asp-action="Index"
                   asp-route-id="@Model.EventId"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
